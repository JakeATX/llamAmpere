+
+// One owner per node, including complete-layer nodes. Release only after upload completion.
+static void moe_cache_urgent_begin(moe_cache_node & node) {
+    GGML_ASSERT(!node.urgent_transfer);
+    node.device->urgent_transfers.fetch_add(1, std::memory_order_acq_rel);
+    node.urgent_transfer = true;
+}
+
+static void moe_cache_urgent_end(moe_cache_node & node) {
+    if (node.urgent_transfer) {
+        node.urgent_transfer = false;
+        const unsigned previous = node.device->urgent_transfers.fetch_sub(1, std::memory_order_acq_rel);
+        GGML_ASSERT(previous > 0);
+    }
+}

