# Flash-Next runtime assets: our Q2S drafter and our v2-r-pure-skip15 expert list (flash-next-experts.strp). Override either path to select other inputs.
flash_next_models=${FLASH_NEXT_MODELS:-/mnt/models}
export LLAMA_ARG_MODEL_DRAFT=${FLASH_NEXT_DRAFTER:-$flash_next_models/flash-next/mtp-Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2S.gguf}
export GGML_MOE_CACHE_PROFILE_LOAD=${FLASH_NEXT_PROFILE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/flash-next-experts.strp}
export GGML_MOE_CACHE_PROFILE_GLOBAL=1
export GGML_MOE_CACHE_PROFILE_PRIOR_PCT=100
export GGML_MOE_CACHE_PROFILE_PRIOR_DECAY=1
export GGML_MOE_CACHE_PROFILE_BLEND_PCT=0
# Cap on ranked experts the cache plans for. 12000 is above what a 24 GB card holds with the standard experts. An AI+
# expert patch makes experts smaller, so more can fit (about 12,570 at a 3090 Ti budget): no cap then, and a value
# already in the environment wins. Without a patch the line is the same as before.
if [[ -n ${LLAMA_MODEL_OVERLAY_PATCH-} ]]; then
    export GGML_MOE_CACHE_PROFILE_RANKED_LIMIT=${GGML_MOE_CACHE_PROFILE_RANKED_LIMIT-24576}
else
    export GGML_MOE_CACHE_PROFILE_RANKED_LIMIT=12000
fi
# Adaptive draft depth 3..4: +1.44% writing over fixed depth 3 (Taichi, 3 task-seed units, prompt flat).
# Empty = engine default; a later --spec-draft-n-max wins.
export FLASH_NEXT_DRAFT_MAX=${FLASH_NEXT_DRAFT_MAX-4}
# PLE prompt prefetch: the engine default applies (4 advise readers, off below 8 GiB MemAvailable);
# LLAMA_PLE_PREFETCH=0 turns it off, LLAMA_PLE_PREFETCH=N forces N readers.
export GGML_MOE_CPU_SPLIT=${GGML_MOE_CPU_SPLIT-1}
export GGML_MOE_CPU_SPLIT_Q2_FAST=${GGML_MOE_CPU_SPLIT_Q2_FAST-1}
export GGML_MOE_CPU_SPLIT_ROWS=${GGML_MOE_CPU_SPLIT_ROWS-1}
export GGML_CUDA_GRAPH_NODE_PRIORITY=${GGML_CUDA_GRAPH_NODE_PRIORITY-1}
# AI+ direct verification defaults, as measured.
export GGML_CUDA_AI23_ID_REF=${GGML_CUDA_AI23_ID_REF-0}
export GGML_CUDA_AI23_MMVR_ID=${GGML_CUDA_AI23_MMVR_ID-1}
export GGML_CUDA_AI23_DIRECT=${GGML_CUDA_AI23_DIRECT-6}
export LLAMA_MOE_SMALL_REDUCE=${LLAMA_MOE_SMALL_REDUCE-1}
export GGML_CUDA_AI23_VERIFY_COMPACT=${GGML_CUDA_AI23_VERIFY_COMPACT-0}
# raw prompt rows stay on the card, as measured
export LLAMA_QSA_RAW_HOST=${LLAMA_QSA_RAW_HOST-0}
