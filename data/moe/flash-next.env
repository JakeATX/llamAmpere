# Flash-Next runtime assets. Override either path to select other inputs.
flash_next_models=${FLASH_NEXT_MODELS:-/mnt/models}
export LLAMA_ARG_MODEL_DRAFT=${FLASH_NEXT_DRAFTER:-$flash_next_models/flash-next/mtp-Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2S.gguf}
export GGML_MOE_CACHE_PROFILE_LOAD=${FLASH_NEXT_PROFILE:-$flash_next_models/profileinv/profile-decode-ship.bin}
export GGML_MOE_CACHE_PROFILE_GLOBAL=1
export GGML_MOE_CACHE_PROFILE_PRIOR_PCT=100
export GGML_MOE_CACHE_PROFILE_PRIOR_DECAY=1
export GGML_MOE_CACHE_PROFILE_BLEND_PCT=0
export GGML_MOE_CACHE_PROFILE_RANKED_LIMIT=12000
