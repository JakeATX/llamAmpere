# 8 GB single-user LSA launch profile (dev, not in a release): Qwen3.8-27B healed-a2p 2.1 bpw + in-file MTP drafter, 200K context.
# Source this file, then start llama-server with the args listed at the end. A value already in the environment wins.
# Measured (F1K, 3090 24 GB proxy at 350 W, agentic 202,752-token prompt): fits at 7,498 MiB, including a checkpoint-restore regenerate.
# Build: the 7,498 MiB fit was measured with the compact stage-strip loader compiled out; on v0.7 that is the opt-in
# cmake -DGGML_CUDA_LSA_STAGE_STRIPS=OFF (a default build keeps it in, ~74 MiB more card memory at 84 SMs).
# TRELLIS_WIDTH(_LSE) below need the trellis-width route (lsa/trellis-width) in the build.
lsa_8gb_dir=${LSA_8GB_DIR:-/mnt/models/lsa-8gb}
# LSA sparse attention: keep 16,384 positions, 3 verify rows share one pick (SHARED=1 failed the coding KLD bar).
export LLAMA_LSA_MODE=${LLAMA_LSA_MODE-key}
export LLAMA_LSA_MAP=${LLAMA_LSA_MAP-$lsa_8gb_dir/lsa-qwen38-27b-d2048.gguf}
export LLAMA_LSA_KEEP=${LLAMA_LSA_KEEP-16384}
export LLAMA_LSA_SHARED=${LLAMA_LSA_SHARED-3}
export LLAMA_LSA_IDX_CACHE=${LLAMA_LSA_IDX_CACHE-1}
export LLAMA_LSA_PACKED=${LLAMA_LSA_PACKED-1}
export LLAMA_LSA_IDX_Q8=${LLAMA_LSA_IDX_Q8-1}
export LLAMA_LSA_IDX_Q4=${LLAMA_LSA_IDX_Q4-1}
export LLAMA_LSA_BLOCK=${LLAMA_LSA_BLOCK-128}
export LLAMA_LSA_BLOCK_TAU=${LLAMA_LSA_BLOCK_TAU-2}
export LLAMA_LSA_SJ_SKIP=${LLAMA_LSA_SJ_SKIP-1}
export LLAMA_LSA_REFINE=${LLAMA_LSA_REFINE-128}
export LLAMA_LSA_REFINE_MULT=${LLAMA_LSA_REFINE_MULT-2}
export LLAMA_LSA_RING_ROWS=${LLAMA_LSA_RING_ROWS-512}
export LLAMA_LSA_FUSED_SEL=${LLAMA_LSA_FUSED_SEL-1}
export LLAMA_LSA_COMP=${LLAMA_LSA_COMP-2}
export LLAMA_LSA_COMP_LB=${LLAMA_LSA_COMP_LB-1}
export LLAMA_LSA_GRAPH_REUSE=${LLAMA_LSA_GRAPH_REUSE-0}
# Full block-means rebuild in at most 8 chunks (bounds its F32 scratch; same means, bitwise). Opt-in on v0.7.
export LLAMA_LSA_MEAN_CHUNKS=${LLAMA_LSA_MEAN_CHUNKS-1}
# 40 resident records (1.64 MiB each); the rest of the 3/3t body is read from host memory.
export LLAMA_LSA_RESIDENT_MIB=${LLAMA_LSA_RESIDENT_MIB-65.7}
export GGML_CUDA_LSA_RESIDENT_STAGE=${GGML_CUDA_LSA_RESIDENT_STAGE-256}
# KV and attention kernels: packed mask, tile skip, 16 MiB trellis prefill, width route for verify (incl. LSE nodes).
export LLAMA_KQ_MASK_PACKED=${LLAMA_KQ_MASK_PACKED-1}
export GGML_SJKVARN_TILE_SKIP=${GGML_SJKVARN_TILE_SKIP-1}
export GGML_SJKVARN_TRELLIS_PREFILL_MIB=${GGML_SJKVARN_TRELLIS_PREFILL_MIB-16}
export GGML_SJKVARN_TRELLIS_WIDTH=${GGML_SJKVARN_TRELLIS_WIDTH-1}
export GGML_SJKVARN_TRELLIS_WIDTH_LSE=${GGML_SJKVARN_TRELLIS_WIDTH_LSE-1}
# MTP drafter: AIT2 head overlay, exact d1 head sidecar, full-vocab head, KL 8.
export LLAMA_SPEC_MB_KL=${LLAMA_SPEC_MB_KL-8}
export LLAMA_MTP_DRAFT_COMPUTE_LEAN=${LLAMA_MTP_DRAFT_COMPUTE_LEAN-0}
export LLAMA_DRAFT_VOCAB_FULL_HEAD=${LLAMA_DRAFT_VOCAB_FULL_HEAD-1}
export LLAMA_MODEL_OVERLAY_PATCH=${LLAMA_MODEL_OVERLAY_PATCH-$lsa_8gb_dir/mtp-dm.gguf,$lsa_8gb_dir/head-ait2.gguf}
export LLAMA_D1_HEAD=${LLAMA_D1_HEAD-$lsa_8gb_dir/head-exact-f16.gguf}
# No CUDA graph for batches over 16 rows: the 256-row prefill chunk after a checkpoint restore ran eagerly, saving 56 MiB
# (7,554 -> 7,498) at the same decode speed. 16 is for a single user (-np 1). Multi-user, derived, not measured: verify rows =
# users x (n_draft+1) = 16 at 4 users n3, but with LLAMA_MTP_DRAFT_UB_MULTI=1 the MTP draft ubatch can reach 8 rows per slot
# (32 at 4 users), so MULTI4 uses 32.
export GGML_CUDA_GRAPH_MAX_ROWS=${GGML_CUDA_GRAPH_MAX_ROWS-16}
# Server args: -m healed-a2p-infile-mtp-r123-drafter-iq4xs.gguf -c 204800 -ngl 99 -fa on -np 1 -b 4096 -ub 256 --fit off --cache-ram 0
#   -ctk sjkvarn3 -ctv sjkvarn3 --sjkvarn-body-type sjkvarn4t --cache-type-s q8_0 -ot token_embd.weight=CPU --load-mode none --no-cache-disk
#   --spec-type draft-mtp --spec-mb-mtp --spec-draft-n-max 3 --spec-n-rs-seq 3 --spec-draft-p-min 0 --spec-draft-window 20480
#   --spec-draft-n-ubatch 8 --spec-draft-vocab-map auto:65536 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0
